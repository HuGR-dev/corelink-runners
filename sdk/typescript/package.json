    "src/index.mjs",
    "src/index.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/conformance.test.mjs"
  },
  "keywords": [
    "corelink",
    "hugr",
    "ed25519",
    "result-binding",
    "attestation",
    "verify"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/humangr-labs/corelink-runners"
  }
