{
  "name": "@corelink/verify",
  "version": "0.1.0",
  "description": "Node reference verifier for CoreLink fabric result-binding v2 (ed25519, byte-identical to crates/corelink-cli/src/binding.rs)",
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
