#!/usr/bin/env bash
# CoreLink Run — Buildkite plugin command hook
#
# Wraps `corelink run` so a Buildkite pipeline runs a memoized, attested job
# on the CoreLink fabric in a single plugins: entry.
#
# Buildkite maps plugin options to env vars automatically:
#   plugin option  →  BUILDKITE_PLUGIN_CORELINK_<OPTION_UPPERCASED>
#
# Required env vars (provided by Buildkite secrets):
#   CORELINK_PAT         — Bearer token; NEVER echoed or logged.
#
# Optional env vars:
#   CORELINK_URL         — Fallback fabric URL (overridden by url plugin option).

set -euo pipefail

# ---------------------------------------------------------------------------
# 1. Resolve configuration from plugin env vars
# ---------------------------------------------------------------------------

# url: plugin option takes priority; falls back to CORELINK_URL env var.
PLUGIN_URL="${BUILDKITE_PLUGIN_CORELINK_URL:-}"
FABRIC_URL="${PLUGIN_URL:-${CORELINK_URL:-}}"

PLUGIN_CHECK="${BUILDKITE_PLUGIN_CORELINK_CHECK:-}"
PLUGIN_CHECK_ID="${BUILDKITE_PLUGIN_CORELINK_CHECK_ID:-}"
PLUGIN_IMAGE="${BUILDKITE_PLUGIN_CORELINK_IMAGE:-}"
# Buildkite serialises booleans as "true"/"false" strings.
PLUGIN_VERIFY="${BUILDKITE_PLUGIN_CORELINK_VERIFY:-true}"

# ---------------------------------------------------------------------------
# 2. Pre-flight checks
# ---------------------------------------------------------------------------

if [[ -z "${CORELINK_PAT:-}" ]]; then
  echo "^^^ +++"
  echo "ERROR: CORELINK_PAT is not set. Add it as a Buildkite secret:"
  echo "  https://buildkite.com/docs/pipelines/secrets"
  echo "The PAT is a CoreLink Personal Access Token (Bearer credential)."
  exit 2
fi

if [[ -z "$PLUGIN_CHECK" ]]; then
  echo "^^^ +++"
  echo "ERROR: The 'check' plugin option is required but was not set."
  exit 2
fi

if [[ -z "$FABRIC_URL" ]]; then
  echo "^^^ +++"
  echo "ERROR: No CoreLink fabric URL configured."
  echo "Set the 'url' plugin option or the CORELINK_URL environment variable."
  exit 2
fi

if ! command -v corelink &>/dev/null; then
  echo "^^^ +++"
  echo "ERROR: corelink binary not found on PATH."
  echo ""
  echo "Until a public release exists, build and cache the binary in an"
  echo "earlier pipeline step:"
  echo ""
  echo "  commands:"
  echo "    - cargo build -p corelink-cli --release --locked"
  echo "    - export PATH=\"\$PWD/target/release:\$PATH\""
  echo ""
  echo "See integrations/buildkite/README.md for details."
  exit 2
fi

# ---------------------------------------------------------------------------
# 3. Build the corelink invocation
# ---------------------------------------------------------------------------
# Construct the argument list incrementally.  The PAT is injected via the
# environment (CORELINK_PAT) — it is never passed on the command line and
# never interpolated into any string that could appear in logs.

ARGS=(run)
ARGS+=(--url "$FABRIC_URL")
ARGS+=(--check "$PLUGIN_CHECK")
ARGS+=(--json)

if [[ -n "$PLUGIN_CHECK_ID" ]]; then
  ARGS+=(--check-id "$PLUGIN_CHECK_ID")
fi

if [[ -n "$PLUGIN_IMAGE" ]]; then
  ARGS+=(--image "$PLUGIN_IMAGE")
fi

if [[ "$PLUGIN_VERIFY" == "false" ]]; then
  ARGS+=(--no-verify)
fi

# ---------------------------------------------------------------------------
# 4. Run
# ---------------------------------------------------------------------------
STDERR_TMP="$(mktemp)"
trap 'rm -f "$STDERR_TMP"' EXIT

# Capture exit code manually so we can distinguish exit-1 (check failed) from
# exit-2 (attestation / wire / auth / unpinned-image error).
set +e
JSON_OUT=$(corelink "${ARGS[@]}" 2>"$STDERR_TMP")
RAW_EXIT=$?
set -e

# Always surface stderr so the Buildkite log shows fabric diagnostics.
if [[ -s "$STDERR_TMP" ]]; then
  cat "$STDERR_TMP" >&2
fi

# ---------------------------------------------------------------------------
# 5. Hard-fail on exit-2 (attestation / wire / auth / unpinned image)
# ---------------------------------------------------------------------------
if [[ $RAW_EXIT -eq 2 ]]; then
  echo "^^^ +++"
  echo "ERROR: corelink exited with code 2 — attestation failed, wire error,"
  echo "auth error, or unpinned image. Do NOT trust this result."
  echo "The fabric rejected the request before any box was provisioned."
  exit 2
fi

# ---------------------------------------------------------------------------
# 6. Parse JSON output
# ---------------------------------------------------------------------------
JSON_TMP="$(mktemp)"
trap 'rm -f "$STDERR_TMP" "$JSON_TMP"' EXIT
echo "$JSON_OUT" > "$JSON_TMP"

# Use python3 (stdlib only) to parse the JSON response.
PARSE_OUT=$(python3 - "$JSON_TMP" "$PLUGIN_VERIFY" <<'PYEOF'
import json
import sys

json_path = sys.argv[1]
verify_mode = sys.argv[2]   # "true" or "false"

try:
    with open(json_path) as f:
        data = json.load(f)
except (FileNotFoundError, json.JSONDecodeError) as e:
    print(f"ERROR: Failed to parse corelink JSON output: {e}", file=sys.stderr)
    sys.exit(2)

lease_id = data.get("lease_id", "")
exit_code = data.get("exit", "")
verified  = str(data.get("verified", False)).lower()
artifacts = data.get("artifacts", [])

# verified=false with verify=true is a hard failure.
if verify_mode != "false" and verified != "true":
    print(
        "ERROR: CoreLink attestation NOT verified (verified=false in fabric response). "
        "Do NOT trust this result. "
        "Set verify: false only for local dev with FABRIC_DEV_UNSAFE=1.",
        file=sys.stderr,
    )
    sys.exit(2)

print(f"LEASE_ID={lease_id}")
print(f"EXIT_CODE={exit_code}")
print(f"VERIFIED={verified}")
for art in artifacts:
    print(f"ARTIFACT path={art.get('path','')} digest={art.get('digest','')}")
PYEOF
)
PARSE_EXIT=$?

if [[ $PARSE_EXIT -ne 0 ]]; then
  echo "^^^ +++"
  echo "ERROR: JSON parse / attestation check failed (see above)."
  exit 2
fi

# Surface structured result to the Buildkite log.
LEASE_ID=""
EXIT_CODE=""
VERIFIED_VAL=""

while IFS= read -r line; do
  case "$line" in
    LEASE_ID=*)   LEASE_ID="${line#LEASE_ID=}"   ;;
    EXIT_CODE=*)  EXIT_CODE="${line#EXIT_CODE=}"  ;;
    VERIFIED=*)   VERIFIED_VAL="${line#VERIFIED=}" ;;
    ARTIFACT*)    echo "  artifact: ${line#ARTIFACT }" ;;
  esac
done <<< "$PARSE_OUT"

echo ""
echo "CoreLink run complete:"
echo "  lease-id : ${LEASE_ID}"
echo "  verified : ${VERIFIED_VAL}"
echo "  exit     : ${EXIT_CODE}"

# ---------------------------------------------------------------------------
# 7. Annotate the build (guarded — only if buildkite-agent is available)
# ---------------------------------------------------------------------------
if command -v buildkite-agent &>/dev/null; then
  STYLE="success"
  if [[ "$RAW_EXIT" -ne 0 ]]; then
    STYLE="error"
  fi
  buildkite-agent annotate \
    --style "$STYLE" \
    --context "corelink-run-${PLUGIN_CHECK_ID:-ci}" \
    "**CoreLink Run** — lease \`${LEASE_ID}\` · verified: \`${VERIFIED_VAL}\` · check exit: \`${EXIT_CODE}\`" \
    2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# 8. Propagate the check exit code as the step result
# ---------------------------------------------------------------------------
# exit 0 = ran + verified + check passed
# exit 1 = ran + verified, but check command itself failed (legitimate job failure)
# exit 2 is already handled above
if [[ "$RAW_EXIT" -ne 0 ]]; then
  echo ""
  echo "ERROR: The check command exited with code $RAW_EXIT on the CoreLink fabric."
  exit "$RAW_EXIT"
fi
