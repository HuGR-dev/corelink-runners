{
  // corelink-fabricd as a Cloudflare Container (gap-#1 option b, owner 2026-06-25).
  // The Rust control plane (RunnerLease API + §13 envelope + attestation key) runs
  // as ONE long-lived singleton container; a thin proxy Worker (src/index.ts) routes
  // every request to it. The runner BOXES still spawn on the separate
  // corelink-spawn-worker (ADR-0008 moat); this is only the control-plane host.
  //
  // ⚠️ NOT YET DEPLOY-VERIFIED — the container build needs the Docker daemon
  // running (cargo build --release of the workspace). Once Docker is up:
  //   npm install && npm run deploy   (then set the secrets — see README.md)
  "name": "corelink-fabricd",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // Same CoreLink infra account as the spawn-Worker (in-network introspect/billing).
  "account_id": "6a1fc1c626fc2628823e60b9db01f5cd",

  // Non-secret config. Secrets (FABRIC_SIGNING_KEY, FABRIC_INTROSPECT_AUTH_KEY,
  // BILLING_INGEST_AUTH_KEY, CLOUDFLARE_SPAWN_AUTH_TOKEN) are set via
  // `wrangler secret put` — NEVER in this file. See README.md.
  "vars": {
    // ── SHARD COUNT (multi-instance fabricd, option 3) ────────────────────────
    // The proxy Worker (src/index.ts) fans acquires round-robin across N shard
    // containers and routes every lease-op back to its owning shard via shardOf.
    // "1" is INERT: shardDoId collapses to the singleton id → byte-identical to
    // the single-instance proxy.
    // RAISE-N: the go-live-readiness-audit N>1 gaps are now CLOSED (the "zero
    // gaps" wave — see docs/handoff/2026-07-09-RAISE-N-*): cap-safety is enforced
    // fail-closed (an N>1 acquire on a non-pg ledger is REFUSED — leases.rs), rate
    // ceiling is divided by N per shard, tenant SUSPEND is durable/cross-instance
    // (fabric_suspended_tenants table), and the Worker now shard-routes the trigger
    // (by body lease_id), round-robins the webhook autoscaler, and scatter-gathers
    // GET /v1/metrics/tenant. So raising N is now safe — the ONLY preconditions:
    //   1. DATABASE_URL (pg) MUST be set (the acquire cap-guard fail-closes N>1
    //      without it, so a misconfigured raise refuses rather than over-admits).
    //   2. Raise this AND `max_instances` (containers block below) TOGETHER.
    // Still owner-gated (do it when real check-host burst volume arrives).
    "FABRIC_NUM_SHARDS": "1",
    "CORELINK_INTROSPECT_URL": "https://corelink-api.humangr.com/internal/v1/auth/introspect",
    "BILLING_INGEST_URL": "https://corelink-api.humangr.com/internal/v1/billing/usage",
    "BILLING_REGION": "iad",
    // Box backend ON (2026-07-03): acquire provisions a real box via the
    // spawn-Worker's POST {url}/v1/spawn (the engine appends /v1/spawn —
    // cloudflare.rs:361, so this is the BASE URL). Previously OFF because
    // /v1/spawn intermittently 500/502/504'd — root-caused to TRANSIENT Cloudflare
    // Durable-Object start errors and fixed in #268 (retry + 202/waitUntil +
    // per-attempt timeout). The shared CLOUDFLARE_SPAWN_AUTH_TOKEN secret is set on
    // both workers (inert without this URL). A container RESTART is required to
    // pick this up (envVars are read at container start).
    "CLOUDFLARE_SPAWN_WORKER_URL": "https://corelink-spawn-worker.gmhelmold.workers.dev",
    // ── MOAT MINT — ARMED (FLIP-A, 2026-07-08 go-live) ────────────────────────
    // Client contract complete both sides: #319 (frozen 5-field body, owner_tenant
    // dropped) + #321 (installation_id OPTIONAL + acquiring PAT via Authorization:
    // Bearer → server introspects → tenant on the native path). Server half LIVE
    // (#674). D1 3/3 GREEN for d863fafb with the canonical slug
    // `HumanGuardrail/corelink-runners` (clw-verified: allowlist + not-offboarded +
    // entitlement=20 — NO seed needed). CLW_ENDPOINT + CORELINK_RUNNER_MINT_URL are
    // the CoreLink API BASE (client appends /internal/v1/runner/{mint,revoke} + the
    // CLW cache path). Secret CORELINK_RUNNER_MINT_AUTH_KEY set via `wrangler secret
    // put`. FABRIC_CRED_TICKET_SECRET already set (env-0 C2c: PAT never in untrusted
    // env — a single-use CLW_CRED_TICKET is injected instead, redeemed at trusted boot).
    "CLW_ENDPOINT": "https://corelink-api.humangr.com",
    "CORELINK_RUNNER_MINT_URL": "https://corelink-api.humangr.com",
    // C2c cred-ticket REDEMPTION target — fabricd's OWN public base. The ticket
    // carries no PAT; the box redeems it at {this}/v1/leases/{id}/cas-cred to get
    // the per-job PAT. REQUIRED whenever the mint is armed: the Rust boot guard
    // (validate_mint_arm) fails closed without it. Without this the moat mints a
    // PAT the box can never redeem → silent cold hydration (go-live audit finding,
    // 2026-07-09). Must be THIS worker's public URL (the cas-cred route lives here).
    "FABRIC_PUBLIC_BASE_URL": "https://corelink-fabricd.gmhelmold.workers.dev",
    // ── ATTESTED COST — ON (FLIP-B) ───────────────────────────────────────────
    // Emit the signed intent_metrics_sig on CloseResponse (#320). Additive +
    // wire-invisible when off; ON now so hugit's ✓cas: can render ATTESTED cost
    // once they pin the conformance vector + consume the field. Signs honest-zero
    // cost until a provider /usage source (never a derived COGS). Prod key faa5b7726.
    "FABRIC_EMIT_INTENT_METRICS_SIG": "true",
    // ── RESILIENCE KNOBS (W1b) — the Rust binary already READS these; they were
    // unset/unforwarded, so crash-surfacing + durable billing export were OFF. ──
    // Crash-surfacing sweep (WP-CRASH-SWEEP): OPT-IN, no pg dependency. 20s is a
    // brisk-but-cheap cadence — a crashed lease (dead box) is surfaced within ~20s
    // instead of only at its deadline. Present-valid-u32≥1 ⇒ spawned; 0/unparseable
    // ⇒ boot Err (absence is the disable path). Forwarded into the container below.
    "FABRIC_CRASH_PROBE_INTERVAL_SECS": "20",
    // Durable billing EXPORT (WP-A): pg-ONLY. ⚠️ server.rs FAIL-CLOSES boot if this
    // is set WITHOUT the pg ledger (FABRIC_LEDGER_BACKEND=pg via DATABASE_URL) — so
    // the proxy forwards it into the container ONLY when DATABASE_URL is present
    // (src/index.ts, inside the DATABASE_URL block). DATABASE_URL IS bound on the
    // live deploy (a wrangler secret — invisible in this file), so pg is the active
    // backend and this durable export is ARMED (not inert). 60s is a sane
    // durable-export cadence (distinct from the always-on 30s corelink push).
    "FABRIC_BILLING_EXPORT_INTERVAL_SECS": "60",
    // ── ACQUIRE-PATH RESILIENCE (W0) — right-size the global inbound bound ─────
    // The code DEFAULT (DEFAULT_MAX_INFLIGHT_REQUESTS = 1024) is a thundering-herd
    // backstop tuned for a big box; on this 2-vCPU singleton it is far above what
    // the box can serve, so load-shed never fires before the runtime browns out.
    // 64 is box-appropriate: above the introspect gate (FABRIC_INTROSPECT_MAX_
    // INFLIGHT default 32, which sheds the acquire storm FIRST) with headroom for
    // the other concurrent work (health, close-ack, lease-ops), yet low enough to
    // shed a genuine herd cleanly (503) well below the 512-thread blocking pool.
    // Forwarded into the container in src/index.ts (the set-but-unforwarded trap:
    // a wrangler var is visible to the Worker as env.* but the CONTAINER only sees
    // what this.envVars sets — an unforwarded var is inert).
    "FABRIC_MAX_INFLIGHT_REQUESTS": "64"
    // ── DEV/TEST cred-ticket mint (POST /v1/test/mint-cred-ticket) — OFF ───────
    // A SENSITIVE dev/test knob: it mints a real single-use cred-ticket for a
    // RESTRICTED test tenant (default f0005), out-of-band, so the clw TL can run
    // their `cred_ticket_redeems_against_the_real_fabric` conformance journey.
    // OFF by default — the route 404s (inert) unless FABRIC_TEST_MINT_KEY is set.
    // DELIBERATELY NOT set here: arm it ONLY for a dev/test flip via a SECRET
    //   `wrangler secret put FABRIC_TEST_MINT_KEY`   (a real high-entropy value;
    // a dev-sentinel/short value fails boot loud), then a container rollout picks
    // it up. Optional `FABRIC_TEST_MINT_TENANTS` (comma-separated) overrides the
    // f0005 allowlist. Forwarded into the container in src/index.ts. Never leave
    // it armed in a steady prod deploy — remove the secret to disable.
  },

  // The singleton control-plane container DO. ONE instance (max_instances 1, a fixed
  // DO id in src/index.ts): DATABASE_URL IS bound → pg-durable ledger, so N>1 is
  // offline-proven + unblocked (flip = raise FABRIC_NUM_SHARDS + max_instances
  // together), but kept at N=1 as a deliberate volume choice. (Only the in-memory
  // fallback — DATABASE_URL absent — would require every /v1 request to hit the SAME
  // process; pg does not.)
  "durable_objects": {
    "bindings": [{ "name": "FABRICD", "class_name": "FabricdContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FabricdContainer"] }],

  "containers": [
    {
      "class_name": "FabricdContainer",
      // DOCKER-FREE DEPLOY (2026-07-03): references the PRE-BUILT fabricd image in
      // the Cloudflare managed registry (the LIVE digest, confirmed via
      // `wrangler containers info`) instead of building the Dockerfile locally — so
      // `wrangler deploy` (incl. a container ROLLOUT to apply new envVars) no longer
      // needs a Docker daemon. To rebuild the control-plane binary: build+push a new
      // image (CI, or a Docker host) and update this @sha256 digest.
      // 2026-07-09 CRED-REDEMPTION-FIX binary (#332). The prior bce176bd zero-gaps
      // binary minted a real per-job PAT but the box could never REDEEM it: C2c
      // injects CLW_CRED_TICKET (no CLW_TOKEN) and the box redeems at
      // {CLW_FABRIC_ENDPOINT}/v1/leases/{id}/cas-cred, but CLW_FABRIC_ENDPOINT is
      // gated on FABRIC_PUBLIC_BASE_URL — which was set NOWHERE (go-live audit
      // wf_63a2b814). This binary adds the validate_mint_arm boot guard that
      // FAILS CLOSED if the mint is armed without FABRIC_PUBLIC_BASE_URL, so a
      // healthy boot now PROVES the redemption endpoint is wired. wrangler.jsonc
      // vars set FABRIC_PUBLIC_BASE_URL (above) + forward it into the container.
      // 2026-07-11 AUDIT-REMEDIATION binary (61fcce2c): adds WP-3 counter
      // completeness (queue-mode admission rejection counters + de-smeared
      // acquire_rejected_no_plan #382) AND the #376 dead-counter wiring
      // (acquire_rejected_lease_invalid at the ledger-decline seams). Additive /
      // default-off — reject-mode byte-identical; the new counters ride
      // /internal/v1/status. Built via `wrangler containers build` (tag
      // audit-remediation-20260711). SUPERSEDES 205494de.
      // 2026-07-10 REAPER-COVERAGE binary (205494de): adds leases_expired +
      // leases_crashed golden counters (#359) — the always-on reaper's terminal
      // reclaims (Held→Expired at deadline, Held→Crashed on dead box) were
      // uncounted, so an abandon-rate rise was invisible. Additive; no behavior
      // change vs 5f1d92db. Built via `wrangler containers build` (tag
      // counters-reaper-20260710).
      // 2026-07-09 OPS-BOOT-ARM binary (5f1d92db): adds the boot-time ops-surface
      // arm-state log (#356) — one stderr line at every boot reporting whether
      // FABRIC_OBSERVABILITY_KEY + FABRIC_ADMIN_KEY are armed (present/absent
      // only, never the value), so a silently-unset ops key is self-evident in
      // the container logs. This rollout ALSO activates the obs+admin secrets
      // (set 2026-07-09) — the singleton container reads env only at boot, so a
      // new image digest is the mechanism that picks up freshly-set secrets.
      // Additive stderr line; no behavior change vs 5d0b6b33 (which added the
      // golden counters #353). Built via `wrangler containers build` (tag
      // ops-boot-arm-20260709).
      // 2026-07-09 OBSERVABILITY binary (5d0b6b33): adds the golden-signal
      // counters (#353) onto the /internal/v1/status aggregate — admission
      // outcomes + one counter per rejection reason, close, CAS PAT mint/revoke
      // attempt+failure, provision capacity-503, agent-exec started/done/failed,
      // load-shed, trigger dedup, suspend. Each counter is a relaxed AtomicU64
      // incremented at the seam (no lock, no alloc, no control-flow change); the
      // DATA rides the SAME obs-key gate as the rest of /internal/v1/status
      // (404 until FABRIC_OBSERVABILITY_KEY is set — it is, forwarded via #340).
      // ADDITIVE / default-safe — no live behavior change vs ddad8014. The prior
      // ddad8014 was the Stage-C binary (console read-APIs #346 + status #347 +
      // revoke cleanup #350). Built via `wrangler containers build` (tag
      // golive-counters-20260709).
      // 2026-07-16 W1-RESILIENCE rollout (5608d67d): SAME Rust binary as 61fcce2c
      // (no crates/ change this wave) — rebuilt only to force a container rollout so
      // the proxy's newly-forwarded envVars take effect (the singleton reads env at
      // boot). Arms FABRIC_CRASH_PROBE_INTERVAL_SECS + (pg-gated)
      // FABRIC_BILLING_EXPORT_INTERVAL_SECS. SUPERSEDES 61fcce2c.
      // 2026-07-18 AUDIT-WAVE binary: fabricd carrying #397 (test-mint enum-oracle),
      // #398 (introspect breaker treats all 5xx as transient + mint-auth-key strength
      // floor), #399 (N>1/tenant docs). @sha256 DIGEST-PINNED (X4) — built by
      // build-fabricd-image.yml, which now resolves the pushed digest via imagetools
      // (#400) instead of falling back to the git-SHA tag. Deployed + verified LIVE:
      // a malformed disarmed test-mint body → 404 (was 422 on the prior fa6b1c3b
      // binary); acquire auth/introspect healthy on the new binary.
      // 2026-07-19 KEY-DRIFT-HARDENING binary (6f899a7a): fabricd carrying #407
      // (introspect success-only short-TTL cache, DEFAULT-OFF via
      // FABRIC_INTROSPECT_CACHE_TTL_MS=0) + #408 (boot introspect self-check —
      // classify_introspect_bootcheck: 2xx→KeyOk, 5xx/None→Transient, <500 non-2xx→
      // KeyRejected; FATAL-on-rejected by default, FABRIC_INTROSPECT_BOOTCHECK=warn
      // escape hatch). Built after the 2026-07-19 key-drift incident (a stale
      // FABRIC_INTROSPECT_AUTH_KEY after a container recycle fail-closed ALL auth as
      // "token store unreachable"; root-caused with the server TL to KEY drift, NOT
      // URL/load). The boot self-check makes that failure LOUD at boot instead of
      // silent-on-first-request: with the (now-correct) key set, boot validates the
      // key against live introspect and passes. @sha256 DIGEST-PINNED (X4), built by
      // build-fabricd-image.yml (run 29707484133). SUPERSEDES 0114c4f2.
      "image": "registry.cloudflare.com/6a1fc1c626fc2628823e60b9db01f5cd/corelink-fabricd-fabricdcontainer@sha256:6f899a7a4feb0ed3b57333f42890f44006b2eb32d5b7fc97f58a5284c833c03d",
      // HTTP control plane. Bumped standard-1 → standard-2 (2026-07-07 acquire-storm
      // hardening): the single-flight singleton must keep /v1/health + lease ops
      // responsive under a burst of box provisions; 2 vCPU gives headroom so a few
      // concurrent provisions can't peg the box (paired with the FABRIC_PROVISION_
      // MAX_INFLIGHT gate that bounds concurrent provisions). Multi-instance (now
      // pg-enabled) is the next scaling step — see README "Known limit".
      "instance_type": "standard-2",
      // ⚠️ Raise in LOCKSTEP with `vars.FABRIC_NUM_SHARDS` — the shard fan-out
      // needs one container instance per shard. N>1 is a separate owner-gated flip.
      "max_instances": 1
    }
  ],

  // Keep-alive: the proxy Worker's scheduled() pings /v1/health every minute so the
  // singleton container never sleeps (sleepAfter) — the "24/7" knob on CF. DATABASE_URL
  // IS bound → the pg-durable ledger (FABRIC_LEDGER_BACKEND=pg) persists lease state
  // across a restart/redeploy. (Only the in-memory fallback — DATABASE_URL absent —
  // would lose lease state on restart.)
  "triggers": { "crons": ["* * * * *"] }
}
