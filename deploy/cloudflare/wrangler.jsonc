{
  // CoreLink spawn-Worker + Container DO (ADR-0008). LIVE — deployed to the
  // gmhelmold CF account; autoscaler (/webhook) + /v1/* spawn surface in prod.
  "name": "corelink-spawn-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // CoreLink infra account (gmhelmold@gmail.com's Account) — the same account
  // that hosts the R2 CAS (corelink-chunk-*/corelink-manifest-*), so a runner
  // Container here reads the cache IN-NETWORK (the ADR-0008 moat win).
  "account_id": "6a1fc1c626fc2628823e60b9db01f5cd",
  // Warm-moat (cache-warm) non-secret config. The per-job CAS PAT is minted via
  // D-9 only when CORELINK_RUNNER_MINT_AUTH_KEY (a Worker SECRET, set by the owner
  // once the Server TL delivers it) is ALSO present — else the runner spawns
  // COLD (fail-open). CLW_TENANT = the dogfood owner tenant (ee30f7ba).
  "vars": {
    "CLW_TENANT": "ee30f7ba-fc25-4d71-939e-ebe130b4c6a3",
    "CLW_ENDPOINT": "https://corelink-api.humangr.com",
    "CORELINK_MINT_URL": "https://corelink-api.humangr.com",
    // Re-drive reconciler allowlist (first-party repos only — a cold re-spawn
    // skips per-job authz). The scheduled() cron scans these for queued+labeled
    // jobs orphaned by a transient spawn failure and re-drives them. Dogfood
    // (this repo) is armed; add product repos only if they are trusted.
    // Canonical org name (matches the webhook payload's repository.full_name AND
    // the REPO_INSTALLATION_MAP key, so the reconciler's WARM re-drive lookup hits).
    "RECONCILER_REPOS": "HumanGuardrail/corelink-runners",
    // Inject the known installation_id for first-party repos (the repo webhook has
    // none) so the server-derived mint (#283) runs WARM without an App webhook.
    // dogfood: HumanGuardrail/corelink-runners → installation 144561227 → tenant
    // d863fafb (verified read-only by the clw coordinator). Key MUST match the
    // webhook payload's repository.full_name exactly.
    "REPO_INSTALLATION_MAP": "{\"HumanGuardrail/corelink-runners\":\"144561227\"}",
    // ── env-0 ARMED (2026-07-06) — no CAS PAT in the untrusted container ──────
    // The root cause (single-use ticket consumed by the boot `clw hydrate`, starving
    // the job's `clw run`) is fixed by the MULTI-USE lease-scoped cred-ticket (#307):
    // both clw processes redeem in-process, so the raw PAT never lands in the env or
    // on disk. Coordinator ACKed the security envelope (multi-use safe: the cred is a
    // per-job, tenant-scoped `cas:rw` PAT — no escalation over the job; C2c keyspace-
    // narrowing rides as an orthogonal Server-TL hardening). SPAWN_WORKER_PUBLIC_URL's
    // presence flips the autoscaler from CLW_TOKEN-in-env to ticket-in-env.
    "SPAWN_WORKER_PUBLIC_URL": "https://corelink-spawn-worker.gmhelmold.workers.dev"
  },
  // Worker logs for `wrangler tail` (were invisible during the stall triage).
  "observability": { "enabled": true },
  // Per-spawn rate limit on /webhook (defense-in-depth vs a leaked webhook
  // secret): 30 queued+labeled spawns / 60s. Ignored events don't count.
  "ratelimits": [
    { "name": "WEBHOOK_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],

  // Re-drive reconciler: run scheduled() every minute to recover jobs orphaned by
  // a transient spawn failure (GitHub fires workflow_job.queued only once). No-op
  // unless RECONCILER_REPOS is set.
  "triggers": { "crons": ["* * * * *"] },

  // job_id -> pat_id map so workflow_job:completed can revoke the per-job CAS PAT
  // by pat_id (the live /revoke contract requires pat_id, not job_id). Written at
  // mint (queued), read+deleted at completion. TTL'd (7200s) as a self-cleaning
  // backstop; eventual consistency is fine (mint->complete is minutes apart).
  "kv_namespaces": [
    { "binding": "RUNNER_JOB_PATS", "id": "4fb7e9c773d64f83ae3415c5a0879d66" }
  ],

  // The Container Durable Objects: the per-job runner container, and (CF-native
  // check-host, campaign B) the per-lease check-host container. A mode:"check"
  // /v1/spawn routes to CHECK_HOST_CONTAINER; /v1/exec dials its exec-server.
  "durable_objects": {
    "bindings": [
      { "name": "RUNNER_CONTAINER", "class_name": "RunnerContainer" },
      { "name": "CHECK_HOST_CONTAINER", "class_name": "CheckHostContainer" },
      // env-0 cred-stash: the single-use latch for the per-job CAS PAT (one DO
      // instance per lease_id = GH jobId). A plain DO (not a Container), so it is
      // NOT a container-image class — just DO storage.
      { "name": "CRED_STASH", "class_name": "CredStashDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RunnerContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["CheckHostContainer"] },
    { "tag": "v3", "new_sqlite_classes": ["CredStashDO"] }
  ],

  // The runner container. IMPORTANT (ADR-0008 / README wrinkle #1): the image is
  // pinned HERE at deploy time, not per-spawn. Keep this digest identical to the
  // clw-pinned runner image in deploy/runner/Dockerfile. The Worker asserts the
  // spawn request's image_digest matches this.
  "containers": [
    {
      "class_name": "RunnerContainer",
      // The real runner image (GH-Actions agent + clw + Rust toolchain).
      // DOCKER-FREE DEPLOY: this now references the PRE-BUILT image in the
      // Cloudflare managed registry, built + pushed by CI (the
      // `.github/workflows/build-cf-container-images.yml` workflow), NOT the local
      // Dockerfile. A local `wrangler deploy` no longer needs a Docker daemon for
      // THIS container.
      //
      // Registry ref format: registry.cloudflare.com/<ACCOUNT_ID>/<IMAGE>:<TAG>
      // (docs: https://developers.cloudflare.com/containers/platform-details/image-management/).
      // This is the LIVE runner image confirmed via `wrangler containers info`.
      // To refresh: run the CI workflow, take the new tag/digest from its job
      // summary, and update this ref (prefer @sha256:<digest> for an immutable X4 pin).
      // REVERTED to the known-good v0.1.1 image (2026-07-05 triage): the v0.1.4
      // image (@sha256:1fdffe…) correlated with dogfood spawns no longer completing
      // even COLD (env-0 disarmed) — so the image, not env-0, is the regression.
      // Re-pin the v0.1.4 digest only after a green spawn on a rebuilt image.
      // clw v0.1.4 image (#292 + #295 build), immutable @sha256 digest pin (X4).
      // (Re-pinned 2026-07-06: the earlier stall was the webhook 400, not this image.)
      "image": "registry.cloudflare.com/6a1fc1c626fc2628823e60b9db01f5cd/corelink-spawn-worker-runnercontainer@sha256:1fdffeaccbbfdeb9c917181acbc702d034beceb418c0e1d1a28f90e538ae1101",
      // standard-4 = 4 vCPU / 12 GiB / 20 GB disk — fits CI, clears the runner
      // disk floor (RUNNER_EPHEMERAL_STORAGE_FLOOR_MB).
      "instance_type": "standard-4",
      "max_instances": 2
    },
    {
      // CF-native check-host (campaign B). Build context = deploy/check-host (its
      // Dockerfile + entrypoint.sh). Runs the in-container exec-server on port 8080
      // (C4); hydrates the toolchain at start from the injected TOOLCHAIN_DIGEST (C5).
      //
      // FIRST PUSH LANDED (2026-07-06): the check-host image is built + pushed to the
      // CF managed registry (W6 unblocked — clw v0.1.5 with --manifest-digest, base
      // ubuntu:24.04 for the GLIBC_2.39 floor, exec-server built musl). Pinned by
      // immutable @sha256 digest (X4) → `wrangler deploy` is now Docker-free for this
      // container too. Rebuild + re-pin via the build-cf-container-images workflow.
      // NOTE: live-flip to prod is still separately gated (real toolchain snapshot +
      // owner go) — deploying the app just moves it out of the stuck "provisioning".
      "class_name": "CheckHostContainer",
      "image": "registry.cloudflare.com/6a1fc1c626fc2628823e60b9db01f5cd/corelink-spawn-worker-checkhostcontainer@sha256:3b694bc66f57dc910b37d11ddab7a933c65559292a48efa1b8457db8a92bd1ce",
      "instance_type": "standard-4",
      "max_instances": 2
    }
  ]

  // R2 binding (in-network CAS hydration — the moat win) is a Cache-TL
  // coordination item (ADR-0008 open decision); add the r2_buckets binding here
  // once the topology + creds are agreed. Intentionally omitted in the skeleton.
}
