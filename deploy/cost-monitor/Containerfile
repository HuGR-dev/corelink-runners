# Official Lambda Node 22 linux/amd64 manifest, resolved 2026-09-06.
FROM --platform=linux/amd64 public.ecr.aws/lambda/nodejs:22@sha256:09d056c2fced577c23464cc03006611dbac0995f4517d74c459cee654162c33b

RUN microdnf install -y openssl && microdnf clean all

WORKDIR ${LAMBDA_TASK_ROOT}
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

CMD ["dist/index.handler"]
