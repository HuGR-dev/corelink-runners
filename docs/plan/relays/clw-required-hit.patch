+/// Look up a memoized result without ever spawning the wrapped command.
+///
+/// `Ok(None)` means the exact computed key did not have a complete, parseable
+/// and CAS-verifiable record. Callers that require a cache hit must treat that
+/// as a miss and choose their own fail-closed exit policy.
+pub async fn run_memoized_required_hit<C: CasTransport + AcTransport>(
+    cwd: &Path,
+    client: &C,
+    opts: &RunOptions,
+) -> Result<Option<RunOutcome>> {
+    if opts.command.is_empty() {
+        return Err(ClwError::InvalidManifest("empty command".to_string()));
+    }
+
+    let key = compute_key(cwd, opts).await?;
+    let Some(record_bytes) = AcTransport::get(client, &key).await? else {
+        return Ok(None);
+    };
+    let Ok(record) = serde_json::from_slice::<RunRecord>(&record_bytes) else {
+        return Ok(None);
+    };
+    let (Ok(stdout), Ok(stderr)) = (
+        CasTransport::get(client, &record.stdout).await,
+        CasTransport::get(client, &record.stderr).await,
+    ) else {
+        return Ok(None);
+    };
+    // Keep the required-hit policy fail-closed even for a transport that does
+    // not uphold the CasTransport integrity contract internally.
+    if Digest::of_bytes(&stdout) != record.stdout || Digest::of_bytes(&stderr) != record.stderr {
+        return Ok(None);
+    }
+
+    Ok(Some(RunOutcome {
+        key,
+        hit: true,
+        exit_code: record.exit_code,
+        stdout,
+        stderr,
+    }))
+}
