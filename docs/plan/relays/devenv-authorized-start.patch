+import { describe, expect, it, vi } from "vitest";
+import { devenvPath, isDevenvStart, mayAccessDevenv, relayAuthorizedDevenvStart, DEVENV_MAX_TTL_SECONDS } from "../src/lib/devenv_relay.js";
+import type { AuthorizedDevenvInput } from "../src/types/devenv_rpc.js";
+const tenant = "00000000-0000-4000-8000-000000000001";
+const session = "00000000-0000-4000-8000-000000000002";
+const patId = "00000000-0000-4000-8000-000000000003";
+const secret = "synthetic-minted-secret";
+const grant = () => ({ tenant, pat_id: patId, token_plaintext: secret, expires_ms: 1000 + DEVENV_MAX_TTL_SECONDS * 1000 });
+const request = (body: unknown = { workspace_name: "workspace" }) => new Request("https://api.invalid/v1/customer/devenv/", { method: "POST", body: JSON.stringify(body) });
+function fixture(issued: unknown = grant()) {
+  return {
+    prepare: vi.fn(async (_operation: string, _tenant: string) => true),
+    adopt: vi.fn(async (_operation: string, _pat: string) => true),
+    mint: vi.fn(async (_operation: string) => Response.json(issued)), revoke: vi.fn(async (_id: string) => true),
+    start: vi.fn(async (input: AuthorizedDevenvInput) => ({ sessionUuid: input.grant.sessionUuid, status: "starting" as const })),
+    now: () => 1000, sessionId: () => session, cleanupFailed: vi.fn(),
+  };
+}
+describe("DevEnv authorized relay", () => {
+  it("matches bounded prefixes and trailing slashes", () => {
+    for (const base of ["/v1/devenv", "/v1/customer/devenv"]) {
+      for (const tail of ["", "/", "///"]) expect(isDevenvStart("POST", base + tail)).toBe(true);
+      expect(isDevenvStart("POST", base + "/stop")).toBe(false);
+      expect(devenvPath(base + "evil")).toBeNull();
+      expect(isDevenvStart("GET", base)).toBe(false);
+    }
+  });
+  it("requires explicit write scope, including WebSocket and GET exec", () => {
+    for (const scope of ["admin", "read-write"]) expect(mayAccessDevenv(request(), scope)).toBe(true);
+    for (const scope of ["", "unknown", "find-missing", "read-only"]) expect(mayAccessDevenv(request(), scope)).toBe(false);
+    expect(mayAccessDevenv(new Request("https://api.invalid/v1/devenv/status"), "read-only")).toBe(true);
+    for (const path of ["", "/tty", "/code", "/vnc", "/stop"]) {
+      expect(mayAccessDevenv(new Request("https://api.invalid/v1/devenv" + path, { headers: { upgrade: "WebSocket" } }), "read-only")).toBe(false);
+      if (path) expect(mayAccessDevenv(new Request("https://api.invalid/v1/devenv" + path), "read-only")).toBe(false);
+    }
+  });
+  it.each([null, [], 12, { workspace_name: "bad/path" }, { workspace_name: "w", tier: "invented" },
+    ...["clw_token", "clwToken", "casPat", "tenantId", "tenant_id", "lease_id", "leaseId", "ticket", "grant", "config"].map((key) => ({ workspace_name: "w", [key]: secret }))])
+    ("rejects malformed/unknown fields before mint", async (body) => {
+      const deps = fixture();
+      expect((await relayAuthorizedDevenvStart(request(body), tenant, deps)).status).toBe(400);
+      expect(deps.mint).not.toHaveBeenCalled(); expect(deps.start).not.toHaveBeenCalled();
+    });
+  it("rejects malformed JSON before mint", async () => {
