diff --git a/worker/src/types/devenv_rpc.ts b/worker/src/types/devenv_rpc.ts
new file mode 100644
index 0000000..96500e7
--- /dev/null
+++ b/worker/src/types/devenv_rpc.ts
@@ -0,0 +1,13 @@
+/** Server-to-runners control capability; never accepted as a public HTTP body. */
+export interface AuthorizedDevenvInput {
+  config: { workspaceName: string; profileName: string; tier: string };
+  grant: { tenantId: string; sessionUuid: string; casPat: string; patId: string; expiresAtMs: number };
+}
+export interface AuthorizedDevenvAck {
+  sessionUuid: string;
+  status: "starting" | "running";
+}
+/** The brand is required by the Cloudflare DurableObjectNamespace RPC generic. */
+export interface RunnerDevEnvRpc extends Rpc.DurableObjectBranded {
+  startAuthorizedDevenv(input: AuthorizedDevenvInput): Promise<AuthorizedDevenvAck>;
+}
diff --git a/worker/tests/devenv_relay.test.ts b/worker/tests/devenv_relay.test.ts
new file mode 100644
index 0000000..e52dcae
--- /dev/null
+++ b/worker/tests/devenv_relay.test.ts
@@ -0,0 +1,89 @@
+import { describe, expect, it, vi } from "vitest";
+import { devenvPath, isDevenvStart, mayAccessDevenv, relayAuthorizedDevenvStart, DEVENV_MAX_TTL_SECONDS } from "../src/lib/devenv_relay.js";
+import type { AuthorizedDevenvInput } from "../src/types/devenv_rpc.js";
+const tenant = "00000000-0000-4000-8000-000000000001";
+const session = "00000000-0000-4000-8000-000000000002";
+const patId = "00000000-0000-4000-8000-000000000003";
+const secret = "synthetic-minted-secret";
+const grant = () => ({ tenant, pat_id: patId, token_plaintext: secret, expires_ms: 1000 + DEVENV_MAX_TTL_SECONDS * 1000 });
+const request = (body: unknown = { workspace_name: "workspace" }) => new Request("https://api.invalid/v1/customer/devenv/", { method: "POST", body: JSON.stringify(body) });
+function fixture(issued: unknown = grant()) {
+  return {
+    mint: vi.fn(async () => Response.json(issued)), revoke: vi.fn(async (_id: string) => true),
+    start: vi.fn(async (input: AuthorizedDevenvInput) => ({ sessionUuid: input.grant.sessionUuid, status: "starting" as const })),
+    now: () => 1000, sessionId: () => session, cleanupFailed: vi.fn(),
+  };
+}
+describe("DevEnv authorized relay", () => {
+  it("matches bounded prefixes and trailing slashes", () => {
+    for (const base of ["/v1/devenv", "/v1/customer/devenv"]) {
+      for (const tail of ["", "/", "///"]) expect(isDevenvStart("POST", base + tail)).toBe(true);
+      expect(isDevenvStart("POST", base + "/stop")).toBe(false);
+      expect(devenvPath(base + "evil")).toBeNull();
+      expect(isDevenvStart("GET", base)).toBe(false);
+    }
+  });
+  it("requires explicit write scope, including WebSocket and GET exec", () => {
+    for (const scope of ["admin", "read-write"]) expect(mayAccessDevenv(request(), scope)).toBe(true);
+    for (const scope of ["", "unknown", "find-missing", "read-only"]) expect(mayAccessDevenv(request(), scope)).toBe(false);
+    expect(mayAccessDevenv(new Request("https://api.invalid/v1/devenv/status"), "read-only")).toBe(true);
+    for (const path of ["", "/tty", "/code", "/vnc", "/stop"]) {
+      expect(mayAccessDevenv(new Request("https://api.invalid/v1/devenv" + path, { headers: { upgrade: "WebSocket" } }), "read-only")).toBe(false);
+      if (path) expect(mayAccessDevenv(new Request("https://api.invalid/v1/devenv" + path), "read-only")).toBe(false);
+    }
+  });
+  it.each([null, [], 12, { workspace_name: "bad/path" }, { workspace_name: "w", tier: "invented" },
+    ...["clw_token", "clwToken", "casPat", "tenantId", "tenant_id", "lease_id", "leaseId", "ticket", "grant", "config"].map((key) => ({ workspace_name: "w", [key]: secret }))])
+    ("rejects malformed/unknown fields before mint", async (body) => {
+      const deps = fixture();
+      expect((await relayAuthorizedDevenvStart(request(body), tenant, deps)).status).toBe(400);
+      expect(deps.mint).not.toHaveBeenCalled(); expect(deps.start).not.toHaveBeenCalled();
+    });
+  it("rejects malformed JSON before mint", async () => {
+    const deps = fixture();
+    expect((await relayAuthorizedDevenvStart(new Request("https://api.invalid", { method: "POST", body: "{" }), tenant, deps)).status).toBe(400);
+    expect(deps.mint).not.toHaveBeenCalled();
+  });
+  it("passes issued credentials and only reflects safe acknowledgement fields", async () => {
+    const deps = fixture();
+    deps.start.mockImplementation(async (input) => ({ sessionUuid: input.grant.sessionUuid, status: "starting", token_plaintext: secret }));
+    const response = await relayAuthorizedDevenvStart(request(), tenant, deps);
+    expect(response.status).toBe(201);
+    expect(await response.json()).toEqual({ sessionUuid: session, status: "starting" });
+    expect(deps.start).toHaveBeenCalledWith({ config: { workspaceName: "workspace", profileName: "default", tier: "standard-4" }, grant: { tenantId: tenant, sessionUuid: session, casPat: secret, patId, expiresAtMs: grant().expires_ms } });
+    expect(deps.revoke).not.toHaveBeenCalled();
+  });
+  it.each([{ tenant: "another-tenant" }, { token_plaintext: " " }, { expires_ms: 1000 }, { expires_ms: 1000 + DEVENV_MAX_TTL_SECONDS * 1000 + 1 }, { expires_ms: null }, { expires_ms: 1001.5 }])
+    ("revokes unusable issued credentials before start", async (override) => {
+      const deps = fixture({ ...grant(), ...override });
+      const response = await relayAuthorizedDevenvStart(request(), tenant, deps);
+      expect(response.status).toBe(503); expect(await response.text()).not.toContain(secret);
+      expect(deps.start).not.toHaveBeenCalled(); expect(deps.revoke).toHaveBeenCalledExactlyOnceWith(patId);
+    });
+  it.each(["", "bad-id", "00000000-0000-0000-0000-000000000000"])("rejects invalid issuer PAT ids", async (id) => {
+    const deps = fixture({ ...grant(), pat_id: id });
+    expect((await relayAuthorizedDevenvStart(request(), tenant, deps)).status).toBe(503);
+    expect(deps.start).not.toHaveBeenCalled();
+  });
+  it("sanitizes RPC throws and retries revocation once", async () => {
+    const deps = fixture(); deps.start.mockRejectedValue(new Error(secret)); deps.revoke.mockRejectedValueOnce(new Error(secret));
+    const response = await relayAuthorizedDevenvStart(request(), tenant, deps);
+    expect(response.status).toBe(503); expect(await response.text()).not.toContain(secret);
+    expect(deps.revoke).toHaveBeenCalledTimes(2); expect(deps.cleanupFailed).not.toHaveBeenCalled();
+  });
+  it("reports unresolved revocation without claiming success", async () => {
+    const deps = fixture(); deps.start.mockRejectedValue(new Error(secret)); deps.revoke.mockResolvedValue(false);
+    expect((await relayAuthorizedDevenvStart(request(), tenant, deps)).status).toBe(503);
+    expect(deps.revoke).toHaveBeenCalledTimes(2); expect(deps.cleanupFailed).toHaveBeenCalledExactlyOnceWith();
+  });
+  it("revokes when acknowledgement names another session", async () => {
+    const deps = fixture(); deps.start.mockResolvedValue({ sessionUuid: "wrong", status: "starting" });
+    expect((await relayAuthorizedDevenvStart(request(), tenant, deps)).status).toBe(503);
+    expect(deps.revoke).toHaveBeenCalledExactlyOnceWith(patId);
+  });
+  it("sanitizes issuer throws", async () => {
+    const deps = fixture(); deps.mint.mockRejectedValue(new Error(secret));
+    const response = await relayAuthorizedDevenvStart(request(), tenant, deps);
+    expect(response.status).toBe(503); expect(await response.text()).not.toContain(secret); expect(deps.start).not.toHaveBeenCalled();
+  });
+});
