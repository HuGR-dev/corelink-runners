+export async function handleRunnerReconcilerRegistry(
+  request: Request,
+  env: RunnerMintEnv,
+): Promise<Response> {
+  if (request.method !== "GET") return reapiError("METHOD_NOT_ALLOWED", "method not allowed", 405);
+  const key = resolveRunnerMintKey(env); // same dedicated internal-auth resolver
+  if (!key) return reapiError("UNAVAILABLE", "unavailable", 503);
+  if (!constantTimeEqual(request.headers.get("x-corelink-internal-auth") ?? "", key)) {
+    return reapiError("UNAUTHORIZED", "unauthorized", 401);
+  }
+  const cursor = parseBoundedCursor(new URL(request.url).searchParams.get("cursor"));
+  if (cursor === "invalid") return reapiError("BAD_REQUEST", "invalid cursor", 400);
+  const page = await queryRunnerReconcilerRegistry(env.CONFIG_DB, cursor);
+  return json(200, page);
+}
@@
+// The query must be the same authority as runner_mint.ts: tenant_gh_installation_map
+// (installation → tenant), runner_repo_allowlist (tenant → repo),
+// tenant_offboarding_state (active only), and runners_entitlement (entitled only).
+// Order by installation_id, repo_full_name and encode the last pair as the
+// opaque cursor. Limit is fixed and bounded; no caller-controlled page size.
+const REGISTRY_PAGE_SIZE = 100;
+const REGISTRY_SQL = `
+  SELECT m.installation_id, a.repo_full_name
+  FROM tenant_gh_installation_map m
+  JOIN runner_repo_allowlist a ON a.tenant_id = m.tenant_id
+  JOIN runners_entitlement e ON e.tenant_id = m.tenant_id
+  LEFT JOIN tenant_offboarding_state o ON o.tenant_id = m.tenant_id
+  WHERE o.tenant_id IS NULL
+    AND (m.installation_id, a.repo_full_name) > (?1, ?2)
+  ORDER BY m.installation_id, a.repo_full_name
+  LIMIT ${REGISTRY_PAGE_SIZE + 1}`;
