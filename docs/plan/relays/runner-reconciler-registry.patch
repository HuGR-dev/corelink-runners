+/**
+ * Installation-scoped recovery inventory for corelink-runners.
+ *
+ * This is a read-only relay over the existing D1 authority. It never accepts
+ * a tenant or eligibility flag from the caller. The query joins the verified
+ * installation map to runner_repo_allowlist and applies the same
+ * offboarding/entitlement gates as runner_mint.ts before emitting a row.
+ */
+export interface RunnerReconcilerRegistryRow {
+  repo_full_name: string;
+  installation_id: string;
+}
+
+export interface RunnerReconcilerRegistryPage {
+  schema_version: 1;
+  source: "runner_repo_allowlist";
+  snapshot_id: string;
+  repositories: RunnerReconcilerRegistryRow[];
+  next_cursor: string | null;
+}
+
+export const RUNNER_RECONCILER_REGISTRY_PATH =
+  "/internal/v1/runner/reconciler-registry";
