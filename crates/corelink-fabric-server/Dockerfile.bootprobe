# DIAGNOSTIC IMAGE — NOT PRODUCTION. Never pin this in a steady deploy.
#
# The fabricd container has not started since 2026-08-19 and the failure is
# INVISIBLE: `onStart` never fires, `health.errors` is empty, and the `exitCode: 0`
# the Worker reports is @cloudflare/containers' hardcoded placeholder for "stopped
# with no exit code recorded" (dist/lib/container.js:1597), not a real exit status.
# Container stdout/stderr lands in Workers Logs, which needs an observability scope
# this session does not hold — `wrangler tail` does NOT carry it (verified: the
# check-host control image executed to a real `exit code: 1` in this same
# application and still emitted no container output to tail).
#
# So the image reports on ITSELF, over the network, to the one surface that IS
# readable here: the fabricd Worker's own request log. Every beacon is a GET whose
# PATH carries the payload, because tail shows `event.request.url` but not bodies.
#
#   /__bootprobe/1-entrypoint-running   the entrypoint got exec'd at all
#   /__bootprobe/2-alive-<yes|no>       the binary is still up 5s in
#   /__bootprobe/3-exit-<rc>/<b64>      it exited: real code + head of its stderr
#
# Reading it:
#   no beacon at all   ⇒ the container never executes; the fault is below our code
#   beacon 1 only      ⇒ it execs, then dies hard before 5s (stderr is the answer)
#   beacon 3           ⇒ the REAL exit code and the REAL error text, at last
#
# Identical to the production Dockerfile except for curl in the runtime stage and
# the wrapper entrypoint. Same digest-pinned bases (X4 floor intact).

FROM rust:1.96@sha256:6df234c1eb92b0545468fab8c18fc5f9adfb994e7d4f67d81d45fe2fcabf5657 AS builder

WORKDIR /build

COPY . .

RUN cargo build --release --bin corelink-fabricd --locked

FROM debian:bookworm-slim@sha256:60eac759739651111db372c07be67863818726f754804b8707c90979bda511df AS runtime

# curl is the beacon transport; bookworm-slim ships neither curl nor bash, and
# dash has no /dev/tcp, so there is no way to report without it.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/corelink-fabricd /usr/local/bin/corelink-fabricd

COPY crates/corelink-fabric-server/bootprobe-entrypoint.sh /usr/local/bin/bootprobe-entrypoint.sh
RUN chmod +x /usr/local/bin/bootprobe-entrypoint.sh

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/bootprobe-entrypoint.sh"]
